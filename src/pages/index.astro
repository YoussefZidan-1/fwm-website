---
import Layout from '../layouts/Layout.astro';
---

<Layout title="fwm — Physics Window Manager">
  <main class="min-h-screen flex flex-col items-center justify-center p-6 text-center">
    <h1 class="font-display italic text-5xl md:text-7xl font-bold tracking-tight text-amber-400 mb-6 drop-shadow-md">
      fwm — Physics Window Manager
    </h1>
    <p class="font-body text-xl text-slate-300 max-w-2xl mb-8 leading-relaxed">
      A Wayland compositor written in C (wlroots) where windows behave as physical objects with mass, momentum, inertia, and velocity.
    </p>
    <div className="font-mono text-sm bg-slate-900 border border-slate-800 text-amber-300/90 px-4 py-2 rounded-lg">
      $ ./install.sh
    </div>
  </main>
</Layout>
</Layout>
