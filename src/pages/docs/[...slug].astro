---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  if (!docs || docs.length === 0) {
    return [];
  }

  const cleanSlug = (id: string) =>
    id.replace(/\.md$/, '').replace(/^README$/i, '');

  const indexEntry =
    docs.find((d) => cleanSlug(d.id) === '') || docs[0];

  const paths = docs.map((entry) => {
    const slug = cleanSlug(entry.id);
    return {
      params: { slug: slug === '' ? undefined : slug },
      props: { entry, docs },
    };
  });

  // Handle root route /docs -> README.md
  if (!paths.some((p) => p.params.slug === undefined)) {
    paths.push({
      params: { slug: undefined },
      props: { entry: indexEntry, docs },
    });
  }

  return paths;
}

const { entry, docs } = Astro.props;

if (!entry) {
  return Astro.redirect('/');
}

const { Content, headings } = await render(entry);

const cleanSlug = (id: string) =>
  id.replace(/\.md$/, '').replace(/^README$/i, '');

const currentSlug = cleanSlug(entry.id);

// Readable titles for sidebar navigation
const navMap: Record<string, string> = {
  '': 'Overview',
  'getting-started': 'Getting Started',
  'configuration': 'Configuration',
  'keybindings': 'Keybindings & Actions',
  'physics': 'Physics Engine',
  'interface': 'The Interface',
  'fwmctl': 'fwmctl & IPC',
  'troubleshooting': 'Troubleshooting',
  'architecture': 'Architecture',
};

const allDocsSummary = docs.map((d) => {
  const slug = cleanSlug(d.id);
  return {
    id: d.id,
    slug,
    title: d.data?.title || navMap[slug] || slug,
  };
});
---

<DocsLayout
  title={entry.data?.title || navMap[currentSlug] || 'Documentation'}
  description={entry.data?.description || 'fwm Wayland compositor documentation'}
  allDocs={allDocsSummary}
  currentSlug={currentSlug}
  headings={headings}
>
  <Content />
</DocsLayout>